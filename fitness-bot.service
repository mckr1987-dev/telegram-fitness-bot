[Unit]
Description=Telegram Fitness Tracker Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fitnessbot
Group=fitnessbot
WorkingDirectory=/opt/fitness-bot
EnvironmentFile=/etc/fitness-bot.env
ExecStart=/usr/bin/python3 /opt/fitness-bot/bot.py
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/fitness-bot/data

[Install]
WantedBy=multi-user.target
